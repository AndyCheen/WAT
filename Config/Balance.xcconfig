// Баланс XP (SPEC-PRIZES §16.13). Правка тут змінює нарахування й довідник «Звідки XP» без коду.
// XcodeGen кладе значення в Info.plist, а `AppContainer` збирає з них `XPRules`.
// У DEBUG змінні середовища з тими самими іменами (схема Xcode → Run → Environment Variables)
// перекривають цей файл. Значення, що не читається (не число, ≤ 0), замінюється типовим.

// XP за кожні WT_XP_VOLUME_STEP_ML мл зарахованої води (у межах стелі 120 %), а не за порцію.
WT_XP_PER_VOLUME_STEP = 5
WT_XP_VOLUME_STEP_ML = 250

// Множить увесь XP: воду, норму, частини доби, завдання, досягнення. Перемножується з серією й бустом.
WT_XP_MULTIPLIER = 1
